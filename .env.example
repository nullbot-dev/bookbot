# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here

# Telegram id администраторов через запятую (узнать свой id: @userinfobot)
ADMIN_IDS=111111111

# Необязательно: id группы, куда приходят уведомления о записях (начинается с -100...).
# Если не задан, уведомления приходят каждому администратору в личку.
ADMIN_CHAT_ID=

# Файл базы данных SQLite
DB_PATH=bookings.db
